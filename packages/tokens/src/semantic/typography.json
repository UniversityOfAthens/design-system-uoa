{
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": {
        "$value": "{font.family.open-sans}",
        "$description": "h2–h6"
      },
      "body": {
        "$value": "{font.family.open-sans}"
      },
      "code": {
        "$value": "{font.family.mono}"
      },
      "display": {
        "$value": "{font.family.katsoulidis}",
        "$description": "h1 and display text — the brand serif"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "body": {
        "$value": "{font.weight.regular}"
      },
      "body-strong": {
        "$value": "{font.weight.semibold}"
      },
      "heading": {
        "$value": "{font.weight.bold}"
      },
      "display": {
        "$value": "{font.weight.bold}",
        "$description": "Katsoulidis has only 400 and 700"
      }
    },
    "size": {
      "$type": "dimension",
      "caption": {
        "$value": "{font.size.100}"
      },
      "body-sm": {
        "$value": "{font.size.200}"
      },
      "body-md": {
        "$value": "{font.size.300}"
      },
      "body-lg": {
        "$value": "{font.size.500}",
        "$description": "Lead paragraphs"
      },
      "display": {
        "$value": "clamp(2.75rem, 1.9rem + 3.6vw, 4.5rem)",
        "$description": "44 → 72px"
      },
      "heading-1": {
        "$value": "clamp(2.25rem, 1.7rem + 2.4vw, 3.5rem)",
        "$description": "36 → 56px"
      },
      "heading-2": {
        "$value": "clamp(1.75rem, 1.45rem + 1.4vw, 2.5rem)",
        "$description": "28 → 40px"
      },
      "heading-3": {
        "$value": "clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem)",
        "$description": "22 → 30px"
      },
      "heading-4": {
        "$value": "{font.size.500}"
      },
      "heading-5": {
        "$value": "{font.size.400}"
      },
      "heading-6": {
        "$value": "{font.size.300}"
      }
    },
    "line-height": {
      "$type": "number",
      "display": {
        "$value": 1.1,
        "$description": "Large sizes only; Greek accents still clear"
      },
      "heading": {
        "$value": "{font.line-height.tight}"
      },
      "body": {
        "$value": "{font.line-height.normal}"
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "display": {
        "$value": "{font.letter-spacing.tighter}"
      },
      "heading": {
        "$value": "{font.letter-spacing.tight}"
      },
      "eyebrow": {
        "$value": "{font.letter-spacing.wide}"
      }
    }
  }
}
