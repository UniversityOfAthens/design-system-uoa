{
  "breakpoint": {
    "$type": "dimension",
    "$description": "Reference values for JS/SCSS. CSS custom properties can't be used inside @media.",
    "sm": { "$value": "576px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  },
  "container": {
    "$type": "dimension",
    "max": { "$value": "75rem", "$description": "1200px" },
    "narrow": { "$value": "45rem", "$description": "720px — long-form text" },
    "gutter": { "$value": "{space.4}" }
  },
  "z-index": {
    "$type": "number",
    "dropdown": { "$value": 100 },
    "sticky": { "$value": 200 },
    "overlay": { "$value": 300 },
    "modal": { "$value": 400 },
    "toast": { "$value": 500 }
  }
}
