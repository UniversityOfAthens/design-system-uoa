{
  "badge": {
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.1}",
      "$description": "Between the dot/icon and the label"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.pill}"
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.body-sm}"
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.body-strong}"
    },
    "neutral-bg": {
      "$type": "color",
      "$value": "{color.surface.muted}"
    },
    "neutral-text": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "info-bg": { "$type": "color", "$value": "{color.feedback.info-surface}" },
    "info-text": { "$type": "color", "$value": "{color.feedback.info-text}" },
    "success-bg": { "$type": "color", "$value": "{color.feedback.success-surface}" },
    "success-text": { "$type": "color", "$value": "{color.feedback.success-text}" },
    "warning-bg": { "$type": "color", "$value": "{color.feedback.warning-surface}" },
    "warning-text": { "$type": "color", "$value": "{color.feedback.warning-text}" },
    "danger-bg": { "$type": "color", "$value": "{color.feedback.danger-surface}" },
    "danger-text": { "$type": "color", "$value": "{color.feedback.danger-text}" }
  }
}
