{
  "card": {
    "bg": {
      "$type": "color",
      "$value": "{color.surface.default}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.thin}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.surface}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.5}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.3}",
      "$description": "Between the blocks inside the body (eyebrow, title, meta, text, footer)"
    },
    "meta-gap": {
      "$type": "dimension",
      "$value": "{space.2}",
      "$description": "Between items in a meta row (date, place, badge)"
    },
    "media-width-horizontal": {
      "$type": "dimension",
      "$value": "{space.24}",
      "$description": "Fixed media width for the horizontal (person/staff) card"
    },
    "title-color": {
      "$type": "color",
      "$value": "{color.text.heading}"
    },
    "text-color": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "meta-color": {
      "$type": "color",
      "$value": "{color.text.muted}"
    },
    "eyebrow-color": {
      "$type": "color",
      "$value": "{color.action.primary}",
      "$description": "Kicker above the title — same pairing as tertiary buttons, so it passes on light surfaces"
    },
    "media-bg": {
      "$type": "color",
      "$value": "{color.surface.muted}",
      "$description": "Placeholder behind the image while it loads"
    }
  }
}
