{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "uoa-ds/badge",
  "version": "0.0.0",
  "title": "Σήμα",
  "category": "text",
  "icon": "marker",
  "description": "Μικρή ετικέτα κατάστασης — νέο πρόγραμμα, προθεσμία, έγκριση, ακύρωση.",
  "keywords": ["badge", "status", "ετικέτα", "κατάσταση"],
  "textdomain": "uoa-ds",
  "attributes": {
    "text": {
      "type": "string",
      "default": "Νέο πρόγραμμα"
    },
    "variant": {
      "type": "string",
      "default": "neutral",
      "enum": ["neutral", "info", "success", "warning", "danger"]
    }
  },
  "supports": {
    "html": false,
    "anchor": false,
    "color": {
      "text": false,
      "background": false,
      "link": false
    },
    "spacing": {
      "padding": false,
      "margin": false
    },
    "typography": {
      "fontSize": false
    }
  },
  "render": "file:./render.php"
}