{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "uoa/card",
  "version": "0.0.0",
  "title": "Κάρτα",
  "category": "uoa",
  "icon": "id-alt",
  "description": "Προεπισκόπηση ενός στοιχείου: νέο, εκδήλωση, πρόσωπο, μάθημα.",
  "keywords": ["card", "teaser", "κάρτα"],
  "textdomain": "uoa-blocks",
  "attributes": {
    "mediaId": { "type": "integer", "default": 0 },
    "mediaAlt": { "type": "string", "default": "" },
    "eyebrow": { "type": "string", "default": "" },
    "title": { "type": "string", "default": "" },
    "url": { "type": "string", "default": "" },
    "headingLevel": { "type": "integer", "default": 3, "enum": [2, 3, 4, 5, 6] },
    "date": { "type": "string", "default": "" },
    "meta": { "type": "array", "default": [], "items": { "type": "string" } },
    "badge": { "type": "string", "default": "" },
    "badgeVariant": { "type": "string", "default": "neutral", "enum": ["neutral", "info", "success", "warning", "danger"] },
    "text": { "type": "string", "default": "" },
    "footerText": { "type": "string", "default": "" },
    "footerUrl": { "type": "string", "default": "" },
    "horizontal": { "type": "boolean", "default": false }
  },
  "supports": { "html": false, "className": false, "customClassName": false },
  "editorScript": "uoa-blocks-editor"
}
