---
// Every brand/accent theme and the colours it sets.
import { themes } from '../lib/tokens';
import ContrastPill from './ContrastPill.astro';

const { kind } = Astro.props as { kind: 'brand' | 'accent' };
const { t } = Astro.locals;
const list = themes.filter((t) => t.kind === kind);
---
<table>
  <thead>
    <tr><th>{t('uoa.table.attribute')} <code>&lt;html&gt;</code></th><th>{t('uoa.table.sets')}</th></tr>
  </thead>
  <tbody>
    {list.map((theme) => (
      <tr>
        <td><code>{theme.attribute}</code></td>
        <td>
          {theme.tokens.map((token) => (
            <div class="uoa-theme-row">
              <span class="uoa-dot" style={`background: ${token.value}`}></span>
              <code>{token.name.replace('--uoa-color-brand-', 'brand-')}</code>
              <span>{token.value}</span>
              <ContrastPill hex={String(token.value)} />
            </div>
          ))}
        </td>
      </tr>
    ))}
  </tbody>
</table>
