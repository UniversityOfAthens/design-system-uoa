---
// Title plus the frontmatter description as a muted lead, like Pajamas and shadcn/ui.
const { title, description } = Astro.locals.starlightRoute.entry.data;
---
<h1 id="_top">{title}</h1>
{description && <p class="uoa-lead">{description}</p>}

<style>
  h1 {
    margin-top: 0.5rem;
    font-size: var(--sl-text-h1);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
  }
  .uoa-lead {
    margin-top: 0.5rem;
    font-size: var(--sl-text-lg);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
</style>
