---
// Header theme controls: a palette button that opens NKUA brand/accent swatches, and a
// light/dark toggle. Brand and accent are stored in localStorage and applied to <html>
// here and inside every example iframe (see Example.astro).
// Rendered twice by Starlight (header and mobile menu), so ids and radio names are per instance.
const { t } = Astro.locals;
const id = `uoa-theme-${Math.random().toString(36).slice(2, 8)}`;

// Swatches get the theme attribute so the tokens CSS colours them; the defaults use the
// www.uoa.gr colours directly because <html> may carry another theme.
const brands = [
  { value: '', label: 'uoa.gr', style: 'background: var(--uoa-color-uoa-navy)' },
  { value: 'red', label: 'Red' },
  { value: 'green', label: 'Green' },
];
const accents = [
  { value: '', label: t('uoa.theme.accentDefault'), style: 'background: var(--uoa-color-uoa-cyan)' },
  ...['azure', 'indigo', 'rose', 'olive', 'vermilion', 'burgundy', 'teal'].map((value) => ({
    value,
    label: value[0].toUpperCase() + value.slice(1),
  })),
];
---
<uoa-theme-picker class="uoa-theme">
  <button class="uoa-icon-button" type="button" popovertarget={id} aria-label={t('uoa.theme.button')} title={t('uoa.theme.button')}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a10 10 0 1 1 10-10c0 2.8-2.2 4-4 4h-1.5a1.5 1.5 0 0 0-1.1 2.5A1.5 1.5 0 0 1 14.3 21 10 10 0 0 1 12 22z"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="10.5" cy="7" r="1"/><circle cx="15" cy="7.5" r="1"/></svg>
    <span class="uoa-theme__dots" aria-hidden="true"><span></span><span></span></span>
  </button>

  <div class="uoa-theme__popover" id={id} popover>
    <fieldset>
      <legend>{t('uoa.theme.brand')}</legend>
      <div class="uoa-theme__options">
        {brands.map((brand) => (
          <label class="uoa-theme__option">
            <input type="radio" name={`${id}-brand`} value={brand.value} data-kind="brand" />
            <span class="uoa-theme__swatch" data-uoa-brand={brand.value || undefined} style={brand.style}></span>
            {brand.label}
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset>
      <legend>{t('uoa.theme.accent')}</legend>
      <div class="uoa-theme__chips">
        {accents.map((accent) => (
          <label class="uoa-theme__chip" title={accent.label}>
            <input type="radio" name={`${id}-accent`} value={accent.value} data-kind="accent" />
            <span class="uoa-theme__swatch" data-uoa-accent={accent.value || undefined} style={accent.style}></span>
            <span class="sr-only">{accent.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>

  <button class="uoa-icon-button" type="button" data-color-scheme-toggle aria-label={t('uoa.theme.darkMode')} aria-pressed="false" title={t('uoa.theme.toggleDarkMode')}>
    <svg class="uoa-theme__sun" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    <svg class="uoa-theme__moon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
  </button>
</uoa-theme-picker>

{/* Inline so the theme is applied before first paint. */}
<script is:inline>
  (() => {
    for (const kind of ['brand', 'accent']) {
      const value = (() => { try { return localStorage.getItem('uoa-' + kind); } catch { return null; } })();
      if (value) document.documentElement.setAttribute('data-uoa-' + kind, value);
    }
  })();
</script>

<script>
  const root = document.documentElement;

  /** Check the radios that match <html> in every picker (header and mobile menu). */
  function syncPickers() {
    for (const input of document.querySelectorAll<HTMLInputElement>('uoa-theme-picker input[data-kind]')) {
      input.checked = input.value === (root.getAttribute(`data-uoa-${input.dataset.kind}`) ?? '');
    }
    const dark = root.dataset.theme === 'dark';
    for (const toggle of document.querySelectorAll('[data-color-scheme-toggle]')) {
      toggle.setAttribute('aria-pressed', String(dark));
    }
  }

  class UoaThemePicker extends HTMLElement {
    connectedCallback() {
      for (const input of this.querySelectorAll<HTMLInputElement>('input[data-kind]')) {
        input.addEventListener('change', () => {
          const attr = `data-uoa-${input.dataset.kind}`;
          if (input.value) root.setAttribute(attr, input.value);
          else root.removeAttribute(attr);
          try { localStorage.setItem(`uoa-${input.dataset.kind}`, input.value); } catch {}
          syncPickers();
          document.dispatchEvent(new CustomEvent('uoa-theme-change'));
        });
      }

      // Light/dark, stored under Starlight's key so its ThemeProvider restores it on load.
      this.querySelector('[data-color-scheme-toggle]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('starlight-theme', next); } catch {}
        syncPickers();
      });

      // Place the popover under its button, right-aligned and kept on screen.
      const button = this.querySelector<HTMLElement>('[popovertarget]')!;
      const popover = this.querySelector<HTMLElement>('[popover]')!;
      popover.addEventListener('toggle', (event) => {
        if ((event as ToggleEvent).newState !== 'open') return;
        const rect = button.getBoundingClientRect();
        const left = Math.min(rect.right - popover.offsetWidth, window.innerWidth - popover.offsetWidth - 8);
        popover.style.top = `${rect.bottom + 8}px`;
        popover.style.left = `${Math.max(8, left)}px`;
      });

      syncPickers();
    }
  }
  customElements.define('uoa-theme-picker', UoaThemePicker);
</script>

<style>
  .uoa-theme { display: flex; gap: 0.25rem; align-items: center; }

  .uoa-icon-button {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    color: var(--sl-color-gray-2);
    background: none;
    border: 0;
    border-radius: 0.5rem;
    cursor: pointer;
  }
  .uoa-icon-button:hover { color: var(--sl-color-white); background: var(--sl-color-gray-6); }

  .uoa-theme__dots { display: flex; }
  .uoa-theme__dots span {
    width: 0.625rem;
    height: 0.625rem;
    background: var(--uoa-color-brand-primary);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--sl-color-bg-nav);
  }
  .uoa-theme__dots span + span { margin-inline-start: -0.1875rem; background: var(--uoa-color-brand-accent); }

  :global([data-theme='light']) .uoa-theme__moon,
  :global([data-theme='dark']) .uoa-theme__sun { display: none; }

  .uoa-theme__popover {
    position: fixed;
    inset: auto;
    width: 17.5rem;
    margin: 0;
    padding: 0.75rem;
    color: var(--sl-color-white);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.12), 0 2px 6px rgb(0 0 0 / 0.06);
  }
  .uoa-theme__popover fieldset { margin: 0; padding: 0; border: 0; }
  .uoa-theme__popover fieldset + fieldset { margin-top: 0.875rem; }
  .uoa-theme__popover legend {
    margin-bottom: 0.5rem;
    padding: 0;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }

  .uoa-theme__options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.375rem; }
  .uoa-theme__option {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    padding: 0.375rem 0.5rem;
    font-size: var(--sl-text-xs);
    font-weight: 500;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    cursor: pointer;
  }
  .uoa-theme__option:hover { background: var(--sl-color-gray-7); }
  .uoa-theme__option:has(:checked) { border-color: var(--sl-color-white); box-shadow: inset 0 0 0 1px var(--sl-color-white); }
  .uoa-theme__option .uoa-theme__swatch { background: var(--uoa-color-brand-primary); }

  .uoa-theme__chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .uoa-theme__chip { display: grid; padding: 0.1875rem; border-radius: 50%; cursor: pointer; }
  .uoa-theme__chip:has(:checked) { box-shadow: 0 0 0 2px var(--sl-color-white); }
  .uoa-theme__chip .uoa-theme__swatch { width: 1.25rem; height: 1.25rem; background: var(--uoa-color-brand-accent); }

  .uoa-theme__swatch {
    flex-shrink: 0;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
  }

  /* Radios are visually hidden; the swatch shows the state and the label keeps focus visible. */
  .uoa-theme__popover input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .uoa-theme__popover label:has(:focus-visible) { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>
