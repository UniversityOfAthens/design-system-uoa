---
// Brand mark + title. Follows the selected brand colour via tokens.
const { locale } = Astro.locals.starlightRoute;
const home = import.meta.env.BASE_URL.replace(/\/$/, '') + (locale ? `/${locale}/` : '/');
---
<a href={home} class="uoa-site-title">
  <span class="uoa-site-title__mark" aria-hidden="true">ΕΚΠΑ</span>
  <span>{Astro.locals.t('uoa.siteTitle')}</span>
</a>

<style>
  .uoa-site-title {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-weight: 700;
    font-size: var(--sl-text-base);
    letter-spacing: -0.01em;
    color: var(--sl-color-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .uoa-site-title__mark {
    display: grid;
    place-items: center;
    height: 1.75rem;
    padding-inline: 0.5rem;
    font-family: var(--uoa-font-family-display);
    font-size: 0.8125rem;
    color: #fff;
    background: var(--uoa-color-brand-primary);
    border-radius: var(--uoa-radius-control);
  }
</style>
