---
// Live example rendered in an isolated iframe with @uoa/core loaded, plus its source
// behind Preview/Code tabs.
// Usage: <Example title="Variants" code={`<button class="uoa-button">…</button>`} />
import { Code } from '@astrojs/starlight/components';

interface Props {
  code: string;
  title?: string;
  /** Padding inside the canvas. Use "none" for full-bleed page examples. */
  padding?: 'default' | 'none';
  /** Show the source panel. */
  showCode?: boolean;
}

const { code, title, padding = 'default', showCode = true } = Astro.props;

function dedent(source: string) {
  const lines = source.replace(/^\n+|\s+$/g, '').split('\n');
  const indent = Math.min(...lines.filter((l) => l.trim()).map((l) => l.match(/^ */)![0].length));
  return lines.map((l) => l.slice(indent)).join('\n');
}

const source = dedent(code);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bodyStyle = padding === 'none'
  ? 'min-height:0;padding:0'
  : 'display:grid;align-content:center;box-sizing:border-box;min-height:9rem;padding:2.5rem 2rem';
const srcdoc = `<!doctype html>
<html lang="el">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="${base}/uoa/fonts/fonts.css">
<link rel="stylesheet" href="${base}/uoa/uoa.css">
<script type="module" src="${base}/uoa/uoa.js"></script>
<style>html{background:transparent}body{${bodyStyle}}</style>
</head>
<body>${source}</body>
</html>`;
const { t } = Astro.locals;
const label = title ?? t('uoa.example.default');
---
<figure class="uoa-example not-content">
  <div class="uoa-example__bar">
    <figcaption>{title}</figcaption>
    {showCode && (
      <div class="uoa-example__tabs" role="tablist" aria-label={`${label}: ${t('uoa.example.view')}`} hidden>
        <button type="button" role="tab" aria-selected="true" data-panel="preview">{t('uoa.example.preview')}</button>
        <button type="button" role="tab" aria-selected="false" data-panel="code">{t('uoa.example.code')}</button>
      </div>
    )}
  </div>
  <div class="uoa-example__panel" data-panel="preview">
    <iframe class="uoa-example__frame" srcdoc={srcdoc} title={label} data-padding={padding}></iframe>
  </div>
  {showCode && (
    <div class="uoa-example__panel uoa-example__code" data-panel="code">
      <Code code={source} lang="html" />
    </div>
  )}
</figure>

<script>
  // Size each iframe to its content and mirror the brand/accent chosen in the header.
  const ATTRS = ['data-uoa-brand', 'data-uoa-accent'];

  function syncTheme(frame: HTMLIFrameElement) {
    const doc = frame.contentDocument?.documentElement;
    if (!doc) return;
    for (const attr of ATTRS) {
      const value = document.documentElement.getAttribute(attr);
      if (value) doc.setAttribute(attr, value);
      else doc.removeAttribute(attr);
    }
  }

  // A srcdoc iframe resolves links against the docs page URL, so "#id" or "#" would load the
  // whole docs page inside the example. Keep examples inert: in-page links move to their
  // target inside the example, every other link and form submit does nothing.
  function keepInside(doc: Document) {
    if (doc.documentElement.dataset.uoaInert) return;
    doc.documentElement.dataset.uoaInert = 'true';
    doc.addEventListener('click', (event) => {
      const link = (event.target as Element).closest?.('a[href]');
      if (!link) return;
      event.preventDefault();
      const id = decodeURIComponent(link.getAttribute('href')!.replace(/^#/, ''));
      const target = link.getAttribute('href')!.startsWith('#') && id ? doc.getElementById(id) : null;
      if (target) {
        if (!target.matches('a, button, input, select, textarea, [tabindex]')) target.setAttribute('tabindex', '-1');
        target.focus();
        target.scrollIntoView({ block: 'nearest' });
      }
    });
    doc.addEventListener('submit', (event) => event.preventDefault());
  }

  function setup(frame: HTMLIFrameElement) {
    const doc = frame.contentDocument;
    if (!doc?.body) return;
    syncTheme(frame);
    keepInside(doc);
    const fit =() => { frame.style.height = `${doc.documentElement.scrollHeight}px`; };
    new ResizeObserver(fit).observe(doc.body);
    fit();
  }

  for (const frame of document.querySelectorAll<HTMLIFrameElement>('.uoa-example__frame')) {
    if (frame.contentDocument?.readyState === 'complete') setup(frame);
    frame.addEventListener('load', () => setup(frame));
  }

  // Preview/Code tabs. Without JavaScript both panels stay visible.
  for (const example of document.querySelectorAll<HTMLElement>('.uoa-example')) {
    const tablist = example.querySelector<HTMLElement>('[role="tablist"]');
    if (!tablist) continue;
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (name: string) => {
      for (const tab of tabs) tab.setAttribute('aria-selected', String(tab.dataset.panel === name));
      for (const panel of example.querySelectorAll<HTMLElement>('.uoa-example__panel')) {
        panel.hidden = panel.dataset.panel !== name;
      }
    };
    for (const tab of tabs) tab.addEventListener('click', () => select(tab.dataset.panel!));
    tablist.hidden = false;
    select('preview');
  }

  document.addEventListener('uoa-theme-change', () => {
    for (const frame of document.querySelectorAll<HTMLIFrameElement>('.uoa-example__frame')) syncTheme(frame);
  });
</script>

<style>
  .uoa-example {
    margin: 1.5rem 0 2rem;
    overflow: hidden;
    background: var(--sl-color-gray-7);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
  }
  .uoa-example__bar {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.375rem 0.5rem 0.375rem 1rem;
  }
  .uoa-example figcaption {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .uoa-example__tabs {
    display: flex;
    gap: 0.125rem;
    padding: 0.1875rem;
    background: var(--sl-color-gray-6);
    border-radius: 0.5rem;
  }
  .uoa-example__tabs[hidden] { display: none; }
  .uoa-example__tabs button {
    padding: 0.1875rem 0.625rem;
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 500;
    color: var(--sl-color-gray-3);
    background: none;
    border: 0;
    border-radius: 0.375rem;
    cursor: pointer;
  }
  .uoa-example__tabs button:hover { color: var(--sl-color-white); }
  .uoa-example__tabs button[aria-selected='true'] {
    color: var(--sl-color-white);
    background: var(--sl-color-black);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  .uoa-example__panel {
    margin: 0 0.375rem 0.375rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
  }
  .uoa-example__panel[hidden] { display: none; }
  .uoa-example__frame {
    display: block;
    width: 100%;
    height: 9rem;
    border: 0;
    /* Examples are always light: the design system has no dark theme yet. */
    background-color: #fff;
    color-scheme: light;
  }
  .uoa-example__code :global(.expressive-code) { margin: 0; }
  .uoa-example__code :global(.expressive-code .frame) { border-radius: 0; box-shadow: none; }
  .uoa-example__code :global(.expressive-code pre) { border: 0; }
</style>
